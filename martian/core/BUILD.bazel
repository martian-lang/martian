load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "core",
    srcs = [
        "argument_map.go",
        "errors.go",
        "fork.go",
        "iostats.go",
        "jobdef.go",
        "jobinfo.go",
        "jobmanager.go",
        "jobmanager_local.go",
        "jobmanager_remote.go",
        "maxjobs_semaphore.go",
        "metadata.go",
        "node.go",
        "override.go",
        "perf.go",
        "pipestance.go",
        "post_process.go",
        "profile_mode.go",
        "resolve.go",
        "resource_semaphore.go",
        "runtime.go",
        "shell_quote.go",
        "stage.go",
        "statfs.go",
        "storage.go",
        "uuid.go",
        "write_atomic.go",
    ] + select({
        "@io_bazel_rules_go//go/platform:linux": [
            "loadavg_linux.go",
            "meminfo_linux.go",
            "perf_unix.go",
            "rlimit.go",
            "statfs_unix.go",
            "write_atomic_linux.go",
        ],
        "@io_bazel_rules_go//go/platform:windows": [
            "loadavg_generic.go",
            "meminfo_generic.go",
            "perf_generic.go",
            "rlimit_windows.go",
            "statfs_generic.go",
            "write_atomic_generic.go",
        ],
        "//conditions:default": [
            "loadavg_generic.go",
            "meminfo_generic.go",
            "perf_generic.go",
            "rlimit.go",
            "statfs_generic.go",
            "write_atomic_generic.go",
        ],
    }),
    importpath = "github.com/martian-lang/martian/martian/core",
    visibility = ["//visibility:public"],
    deps = [
        "//martian/syntax",
        "//martian/util",
        "@org_golang_x_sys//unix:go_default_library",
    ],
)

