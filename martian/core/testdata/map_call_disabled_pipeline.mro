# Map call over the output of a map call inside a sub-pipeline which is
# disabled by a value only known at runtime.
#
# Distilled from SC_MULTI_CS in cellranger, where the SANITIZE_MAP_CALLS
# stage existed to work around the downstream map call being unable to
# split the sub-pipeline's merged map call output.

stage PASS_MAP(
    in  map<int> what,
    out map<int> result,
    src exec     "stage.py",
)

stage WORK_BOOL(
    in  bool what,
    out bool result,
    src exec "stage.py",
)

stage WORK_INT(
    in  int what,
    out int result,
    src exec "stage.py",
)

pipeline INNER(
    in  map<int> inputs,
    out map<int> result,
)
{
    call PASS_MAP as DELAY(
        what = self.inputs,
    )

    map call WORK_INT(
        what = split DELAY.result,
    )

    return (
        result = WORK_INT.result,
    )
}

pipeline TOP(
    in  map<int> inputs,
    out map<int> result,
)
{
    call WORK_BOOL as FLAG(
        what = false,
    )

    call INNER(
        inputs = self.inputs,
    ) using (
        disabled = FLAG.result,
    )

    map call WORK_INT as CONSUMER(
        what = split INNER.result,
    )

    return (
        result = CONSUMER.result,
    )
}

call TOP(
    inputs = {
        "x": 1,
        "y": 2,
    },
)
