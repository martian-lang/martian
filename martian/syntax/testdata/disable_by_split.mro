stage PASS_MAP(
    in  map<int> what,
    out map<int> result,
    src comp     "nope",
)

stage WORK_INT(
    in  int what,
    out int result,
    src comp "nope",
)

pipeline INNER(
    in  map<int> inputs,
    out map<int> result,
)
{
    call PASS_MAP as DELAY(
        what = self.inputs,
    )

    map call WORK_INT(
        what = split DELAY.result,
    )

    return (
        result = WORK_INT.result,
    )
}

pipeline MID(
    in  map<int> inputs,
    in  bool     disable,
    out map<int> result,
)
{
    call INNER(
        inputs = self.inputs,
    ) using (
        disabled = self.disable,
    )

    map call WORK_INT as CONSUMER(
        what = split INNER.result,
    )

    return (
        result = CONSUMER.result,
    )
}

pipeline TOP(
    in  map<int>   inputs,
    out map<int>[] result,
)
{
    map call MID(
        inputs  = self.inputs,
        disable = split [
            true,
            false,
        ],
    )

    return (
        result = MID.result,
    )
}

call TOP(
    inputs = {
        "x": 1,
        "y": 2,
    },
)
